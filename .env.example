# Masukkan API Key gratis dari Google AI Studio di sini:
# Dapatkan di: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Konfigurasi Database (MySQL XAMPP / MariaDB)
# Nilai DB_TYPE: 'auto' (otomatis deteksi MySQL XAMPP & fallback ke SQLite jika MySQL mati), 'mysql', atau 'sqlite'
DB_TYPE=auto
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=photobooth_db

