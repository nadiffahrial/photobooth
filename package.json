{
  "name": "photobooth",
  "version": "1.0.0",
  "description": "Aplikasi photobooth modern dengan Node.js, React, Express, dan Flask",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "server": "node server.js",
    "client": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix frontend run build",
    "start": "node server.js"
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0"
  }
}
